{
  "name": "@spooldoc/web",
  "version": "0.0.0",
  "private": true,
  "description": "Spooldoc web app: servers, queues, jobs that turn spooled files into documents, and the job log",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strom-Capital/spooldoc.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/Strom-Capital/spooldoc#readme",
  "bugs": "https://github.com/Strom-Capital/spooldoc/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "UV_THREADPOOL_SIZE=16 next dev -p 3002",
    "build": "next build",
    "start": "UV_THREADPOOL_SIZE=16 next start -p 3002",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/gateway": "^4.0.116",
    "@ai-sdk/google": "^4.0.99",
