# Copy to .env.local and fill in. DATABASE_URL, BETTER_AUTH_SECRET and
# SPOOLDOC_SECRET_KEY are required.

# Postgres connection string. `docker compose up -d db` at the repository root starts one:
# DATABASE_URL=postgres://spooldoc:spooldoc@localhost:5433/spooldoc
DATABASE_URL=

# Signs the login sessions (Better Auth). At least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encrypts the IBM i passwords of saved servers and the model keys (AES-256-GCM). 32 bytes in base64.
# Generate one with: openssl rand -base64 32
# Keep it: with another key the saved passwords cannot be read and must be entered again.
SPOOLDOC_SECRET_KEY=

# Address users reach this app at. Origin checks accept it and the request's own host;
# cookies are marked secure when this is https.
# APP_URL=http://localhost:3000

# The queue watcher runs in this process unless this is off (for example on every
# instance but one; the watcher also takes database locks, so two never read the same
# data queue or run the same job at once). Default on.
# SPOOLDOC_WATCHER=on

# Migrations run when the server starts unless this is off (then run pnpm db:migrate).
# SPOOLDOC_MIGRATE=on

# The AI assistant's provider, key, model and effort are set in the app under Settings.

# Code page for spooled files without a CHRID when the job CCSID is not supported,
# for example 273 or 37.
# SPOOLDOC_DEFAULT_CCSID=

# Comma-separated hosts servers may use. When set, the server form shows a list
# instead of a free text field.
# SPOOLDOC_ALLOWED_HOSTS=

# How much the server logs to stdout, as one JSON object per line:
# off, error, warn, info or debug. Default info.
# SPOOLDOC_LOG_LEVEL=info
