# Copy to .env.local and fill in. Only SESSION_SECRET is required.

# Encrypts the session cookie that holds the IBM i sign-on. At least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Address users reach this app at. Origin checks accept it and the request's own host;
# the cookie is marked secure when this is https.
# APP_URL=http://localhost:3002

# Workspace folder with samples, definitions and templates. A relative path is taken
# from the repository root. Default: workspace/ at the repository root.
# SPOOLDOC_WORKSPACE=

# The model for the workbench chat. Keys stay on the server; no request can supply
# one. Anthropic is used when its key is set. Without a model the chat panel says so
# and the rest of the app works as before.
# ANTHROPIC_API_KEY=
# SPOOLDOC_MODEL=claude-sonnet-5-5

# Or an OpenAI-compatible endpoint (for example a local model server).
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# Mask values (digits to 9, letters to X or x) in page text and tool results before
# they go to the model. Labels that repeat across pages stay readable. Default true.
# SPOOLDOC_MASK=true

# Code page for spooled files without a CHRID when the job CCSID is not supported,
# for example 273 or 37.
# SPOOLDOC_DEFAULT_CCSID=

# A Chromium or Chrome executable for PDF rendering (with playwright-core installed).
# SPOOLDOC_CHROMIUM_PATH=

# Comma-separated hosts the connect form may use. When set, the form shows a list
# instead of a free text field.
# SPOOLDOC_ALLOWED_HOSTS=
