---
import type { Post } from '../lib/posts';
import { formatDate, url } from '../lib/links';

interface Props { posts: Post[]; headingLevel?: 'h2' | 'h3' }
const { posts, headingLevel: H = 'h3' } = Astro.props;
---
<ul class="posts">
  {posts.map((post) => (
    <li>
      <a class="post" href={url(`/blog/${post.id}/`)}>
        <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="body">
          <H class="title">{post.data.title}</H>
          <span class="desc">{post.data.description}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .posts li { border-bottom: 1px solid var(--border); container-type: inline-size; }
  .post { display: grid; gap: 6px 32px; padding: 20px 0; text-decoration: none; color: var(--foreground); }
  @container (min-width: 640px) { .post { grid-template-columns: 180px minmax(0, 1fr); } }
  .meta { font: 13px/1.5 var(--font-mono); color: var(--muted-foreground); padding-top: 3px; }
  .body { display: grid; gap: 4px; min-width: 0; }
  .title { margin: 0; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.015em; }
  .desc { color: var(--muted-foreground); font-size: 0.95rem; max-width: 64ch; }
  .post:hover .title { color: var(--primary); }
</style>
