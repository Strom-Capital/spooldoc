---
/**
 * Draws the Mermaid diagrams of a guide (```mermaid fences, which Shiki leaves as text)
 * in the browser, in the page theme, and again when the theme changes. Mermaid loads
 * only on a page that has one. Without JavaScript the diagram's source shows.
 */
---
<script>
  type Block = { pre: HTMLPreElement; source: string; host: HTMLDivElement };

  const blocks: Block[] = [...document.querySelectorAll<HTMLElement>('pre > code.language-mermaid')].map((code) => {
    const pre = code.parentElement as HTMLPreElement;
    const host = document.createElement('div');
    host.className = 'mermaid-diagram';
    pre.after(host);
    return { pre, source: code.textContent ?? '', host };
  });

  function isDark(): boolean {
    const theme = document.documentElement.getAttribute('data-theme');
    return theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  }

  let count = 0;

  async function draw() {
    if (blocks.length === 0) return;
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, theme: isDark() ? 'dark' : 'neutral', securityLevel: 'strict', fontFamily: 'Geist Variable, sans-serif' });
    for (const block of blocks) {
      try {
        const { svg } = await mermaid.render(`mermaid-${++count}`, block.source);
        block.host.innerHTML = svg;
        block.pre.hidden = true;
      } catch {
        // The source stays readable when the diagram cannot be drawn.
        block.pre.hidden = false;
        block.host.innerHTML = '';
      }
    }
  }

  void draw();
  document.addEventListener('themechange', () => void draw());
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => void draw());
</script>

<style is:global>
  .mermaid-diagram { margin: var(--space-5) 0; padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); overflow-x: auto; text-align: center; }
  .mermaid-diagram:empty { display: none; }
  .mermaid-diagram svg { max-width: 100%; height: auto; }
</style>
