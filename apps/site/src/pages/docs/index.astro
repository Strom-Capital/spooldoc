---
import Docs from '../../layouts/Docs.astro';
import { DOCS_INDEX_DESCRIPTION, docsIndex, siteDocsHtml } from '../../lib/docs';
import { renderMarkdown } from '../../lib/markdown';

/** docs/README.md: the groups of guides, as on GitHub. */
const index = docsIndex();
const html = siteDocsHtml(await renderMarkdown(index.markdown));
---
<Docs title={index.title} description={DOCS_INDEX_DESCRIPTION} headings={index.headings} file="README.md">
  <Fragment set:html={html} />
</Docs>
