---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Shot from '../components/Shot.astro';
import { DEFINITION_EXAMPLE, FEATURES, QUICK_START } from '../lib/features';
import { docsUrl, links } from '../lib/links';
---
<Base title="Features" description="What Spooldoc does today: your programs print as they always have, YAML definitions read the pages, HTML, Word and Excel templates lay them out, the agent drafts, and every run is in the job log.">
  <section class="section intro">
    <div class="container">
      <div class="section-head">
        <h1>What Spooldoc does today</h1>
        <p class="lead">
          Each feature here works in the latest release. The guides have the details,
          and the <a href={links.releases}>release notes</a> say what changed.
        </p>
      </div>
      <nav class="toc" aria-label="Features">
        <ul>
          {FEATURES.map((feature) => <li><a href={`#${feature.id}`}>{feature.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  {FEATURES.map((feature, i) => (
    <section class="feature" id={feature.id} aria-labelledby={`${feature.id}-title`}>
      <div class:list={['container', 'feature-grid', { flip: i % 2 === 1 }]}>
        <div class="text">
          <h2 id={`${feature.id}-title`}><a class="anchor" href={`#${feature.id}`}>{feature.title}</a></h2>
          {feature.body.map((paragraph) => <p set:html={paragraph} />)}
          {feature.id === 'definitions' && <CodeBlock code={DEFINITION_EXAMPLE} lang="yaml" title="YAML, from the invoice example" />}
          {feature.id === 'compose' && <CodeBlock code={QUICK_START} lang="sh" title="Shell" track="install_command_copied" />}
          <p class="docs">
            {feature.docs.map((doc, j) => (
              <>
                {j > 0 && ' and '}
                <a href={docsUrl(doc.slug)}>{j === 0 ? `Read the ${doc.title} guide` : doc.title}</a>
              </>
            ))}
          </p>
        </div>
        <Shot name={feature.shot} alt={feature.alt} eager={i === 0} />
      </div>
    </section>
  ))}
</Base>

<style>
  .intro { padding-bottom: var(--space-5); }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .toc a { display: inline-flex; align-items: center; min-height: 34px; padding: 0 12px; border: 1px solid var(--border); border-radius: 999px; color: var(--foreground); text-decoration: none; font-size: 0.9rem; }
  .toc a:hover { background: var(--muted); }

  .feature { padding-top: var(--space-8); }
  .feature-grid { display: grid; gap: var(--space-5); align-items: start; }
  @media (min-width: 1000px) {
    .feature-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); }
    .feature-grid.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .feature-grid.flip .text { order: 2; }
  }
  .text { min-width: 0; }
  .text h2 { margin-bottom: var(--space-4); }
  .anchor { color: inherit; text-decoration: none; }
  .anchor:hover { color: var(--primary); }
  .text p { color: var(--muted-foreground); }
  .text :global(p a), .text :global(p code) { color: var(--foreground); }
  .text :global(p a) { color: var(--primary); }
  .docs { font-weight: 500; }
</style>
