/* SPDCLEAN: remove the demo spooled files and objects.               */
/*   CALL PGM(MYLIB/SPDCLEAN) PARM(MYLIB)                              */
/* WARNING: clears output queues FORMS, EMAIL and REPORTS in &LIB,    */
/* which deletes every spooled file on them that you may delete, then */
/* deletes the queues, the data queue SPLFDTAQ, the demo programs and */
/* the SPDPRINT command. It keeps itself and source file SPDSRC.      */
/* Errors such as "not found" are ignored.                            */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)

             CLROUTQ    OUTQ(&LIB/FORMS)
             MONMSG     MSGID(CPF0000)
             CLROUTQ    OUTQ(&LIB/EMAIL)
             MONMSG     MSGID(CPF0000)
             CLROUTQ    OUTQ(&LIB/REPORTS)
             MONMSG     MSGID(CPF0000)

/* Give the spool a moment to finish deleting before the queues go.   */
             DLYJOB     DLY(2)

             DLTOUTQ    OUTQ(&LIB/FORMS)
             MONMSG     MSGID(CPF0000)
             DLTOUTQ    OUTQ(&LIB/EMAIL)
             MONMSG     MSGID(CPF0000)
             DLTOUTQ    OUTQ(&LIB/REPORTS)
             MONMSG     MSGID(CPF0000)
             DLTDTAQ    DTAQ(&LIB/SPLFDTAQ)
             MONMSG     MSGID(CPF0000)

             DLTCMD     CMD(&LIB/SPDPRINT)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(&LIB/SPDPRINTC)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(&LIB/SPDORDERR)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(&LIB/SPDINVOICE)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(&LIB/SPDPICK)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(&LIB/SPDXML)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(&LIB/SPDSETUP)
             MONMSG     MSGID(CPF0000)

             SNDPGMMSG  MSG('Demo spool objects removed from' *BCAT &LIB) +
                          MSGTYPE(*COMP)
             ENDPGM
