{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "node",
      "initial-version": "0.1.0",
      "package-name": "spooldoc",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["apps/site"],
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/docs/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/ibmi/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
